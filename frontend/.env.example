# Base URL of the WorkforceOS backend API.
# Leave empty to use a same-origin relative path (/api/v1) — useful when the SPA is
# served behind a reverse proxy that forwards /api to the backend.
# For a fully separate deployment (frontend and backend on different origins), set the
# absolute API root, e.g. https://api.example.com/api/v1
VITE_API_BASE_URL=
